---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgendaMockup from './AgendaMockup.astro';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import ProductScreenshot from './ProductScreenshot.astro';
import SuiteMark from './SuiteMark.astro';
import teamScreenshot from '../assets/imagen-equipo-consultorio.png';
import radiographsScreenshot from '../assets/informacion-centralizada-paciente.png';
import reminderActivated from '../assets/recordatorio-activado.webp';
import { getLandingCopy, type LandingVariant } from '../content/landing';

interface Props {
  variant?: LandingVariant;
}

const { variant = 'general' } = Astro.props;
const copy = getLandingCopy(variant);
const appUrl = 'https://cita-suite.netlify.app/login';
const instagramUrl = 'https://www.instagram.com/citasuite?igsh=eHExeHhxcmllMzhh&igsi=eHExeHhxcmllMzhh';

const questions = [
  {
    key: 'reservation',
    question: '¿Coordinar un turno todavía requiere mensajes, llamadas o intervención de recepción para encontrar un horario?',
    summary: 'Coordinar turnos requiere ida y vuelta'
  },
  {
    key: 'reminders',
    question: '¿Algunos pacientes se olvidan del turno y pueden no presentarse?',
    summary: 'Pacientes que se olvidan del turno'
  },
  {
    key: 'information',
    question: copy.informationQuestion,
    summary: copy.informationSummary
  }
];

const faqs = [
  {
    question: '¿Tengo que instalar algo?',
    answer: 'No. Cita Suite funciona desde el navegador, por lo que podés acceder desde las computadoras del consultorio sin instalar un programa tradicional.'
  },
  {
    question: '¿Pueden usarlo varios profesionales?',
    answer: 'Sí. El consultorio puede trabajar con distintos usuarios y roles para que recepción, profesionales y administración accedan a las funciones que les corresponden.'
  },
  { question: copy.filesFaqQuestion, answer: copy.filesFaqAnswer },
  {
    question: '¿Cómo funcionan los recordatorios?',
    answer: 'Cita Suite puede avisarle al paciente durante el día previo y 2 horas antes del turno para reducir la dependencia de recordatorios manuales.'
  },
  {
    question: '¿Tengo que configurar todo yo?',
    answer: 'No. Si preferís, te acompañamos con la configuración inicial del consultorio, sus profesionales, servicios, horarios y disponibilidad.'
  },
  {
    question: '¿Qué pasa si necesito ayuda?',
    answer: 'Podés solicitar asistencia directamente cuando la necesites. Durante la puesta en marcha también podemos ayudarte a dejar el consultorio preparado para empezar a trabajar.'
  },
  {
    question: '¿Se puede usar desde el celular?',
    answer: 'Cita Suite está pensado principalmente para el trabajo cotidiano desde computadora. Los pacientes, en cambio, pueden acceder desde su celular a los enlaces relacionados con sus turnos.'
  },
  {
    question: '¿Quién puede ver la información de los pacientes?',
    answer: 'Los accesos se organizan según los roles y permisos definidos dentro del consultorio.'
  }
];
---

<BaseLayout title={copy.pageTitle} description={copy.pageDescription}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" data-header>
    <div class="container header-inner">
      <Brand compact />

      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#soluciones">Funciones</a>
        <a href="#precio">Precio</a>
        <a href="#preguntas">Preguntas frecuentes</a>
      </nav>

      <div class="header-actions">
        <a class="login-link" href={appUrl}>Ingresar</a>
        <button class="button button-small button-primary" type="button" data-trial-cta data-cta-location="header">Quiero probar Cita Suite</button>
      </div>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-icon"><Icon name="menu" size={23} /></span>
        <span class="close-icon"><Icon name="x" size={23} /></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" data-mobile-menu>
      <nav aria-label="Navegación móvil">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#soluciones">Funciones</a>
        <a href="#precio">Precio</a>
        <a href="#preguntas">Preguntas frecuentes</a>
        <a href={appUrl}>Ingresar</a>
        <button class="button button-primary" type="button" data-trial-cta data-cta-location="mobile-menu">Quiero probar Cita Suite</button>
      </nav>
    </div>
  </header>

  <main id="contenido" data-landing-root data-variant={variant}>
    <section class="hero" id="inicio" data-track-section="hero">
      <div class="hero-decoration hero-decoration-one"></div>
      <div class="hero-decoration hero-decoration-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span></span> {copy.eyebrow}</div>
          <h1>Menos turnos perdidos. <span>Toda la información</span> del consultorio, en un solo lugar.</h1>
          <p class="hero-lead">{copy.heroLead}</p>
          <div class="hero-actions">
            <a class="button button-primary button-large" href="#como-funciona" data-track-cta="hero-see-how">Ver cómo funciona <Icon name="arrow-right" size={18} /></a>
            <button class="button button-secondary button-large" type="button" data-trial-cta data-cta-location="hero">Quiero probar Cita Suite</button>
          </div>
        </div>

        <div class="hero-product" aria-label="Vista real de la agenda de Cita Suite">
          <div class="product-label"><span class="live-dot"></span> Vista de agenda</div>
          <AgendaMockup />
        </div>
      </div>
    </section>

    <section class="trust-bar" aria-label="Beneficios de implementación">
      <div class="container trust-grid">
        <div><span><Icon name="sparkles" size={18} strokeWidth={2} /></span><strong>Te lo dejamos listo para usar</strong></div>
        <div><span><Icon name="shield" size={18} strokeWidth={2} /></span><strong>Elegí quién puede ver y qué puede hacer</strong></div>
        <div><span><Icon name="message" size={18} strokeWidth={2} /></span><strong>Te ayudamos cuando lo necesites</strong></div>
        <div><span><Icon name="check" size={18} strokeWidth={2.4} /></span><strong>Sin instalación</strong></div>
      </div>
    </section>

    <section class="section diagnostic-section" id="como-funciona" data-track-section="diagnostic">
      <div class="container">
        <div class="section-heading centered narrow reveal">
          <h2>¿Te pasan algunas de estas cosas?</h2>
          <p class="section-kicker diagnostic-duration">Se responde en 10 segundos</p>
        </div>

        <div class="diagnostic-card reveal" data-diagnostic>
          <div class="diagnostic-progress" aria-label="Progreso del cuestionario">
            <span data-progress-label>Pregunta 1 de 3</span>
            <div class="diagnostic-marks">
              {[0, 1, 2].map((index) => <SuiteMark index={index} />)}
            </div>
          </div>

          <div class="diagnostic-question" data-question-panel aria-live="polite">
            <h3 data-question-text>{questions[0].question}</h3>
            <div class="diagnostic-answers">
              <button class="diagnostic-answer diagnostic-answer-yes" type="button" data-answer="yes">
                <span><Icon name="check" size={18} strokeWidth={2.4} /></span> Sí, me pasa
              </button>
              <button class="diagnostic-answer diagnostic-answer-no" type="button" data-answer="no">No tanto</button>
            </div>
          </div>

          <div class="diagnostic-result" data-diagnostic-result hidden aria-live="polite">
            <h3 data-result-title>Te pasa esto:</h3>
            <ul data-result-list></ul>
            <p class="result-conclusion" data-result-conclusion>Cita Suite está pensado justamente para resolver esto.</p>
            <a class="button button-primary button-large button-emphasis" href="#solucion-reserva" data-result-cta>
              <span data-result-cta-label>Mirá cómo lo resuelve Cita Suite</span> <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      </div>
      <script is:inline type="application/json" data-question-config set:html={JSON.stringify(questions)}></script>
    </section>

    <div id="soluciones">
      <section class="section solution-section reservation-section" id="solucion-reserva" data-problem="reservation" data-track-section="reservation">
        <div class="container">
          <div class="solution-grid">
            <div class="solution-copy reveal">
              <span class="section-kicker">Conseguir el turno</span>
              <h2>El paciente encuentra y reserva un horario sin ida y vuelta</h2>
              <p>Compartí el enlace de reserva de tu consultorio. El paciente elige profesional, fecha y horario disponible, completa sus datos y confirma el turno por su cuenta.</p>
              <div class="solution-points">
                <span><Icon name="check" size={16} strokeWidth={2.4} /> Disponibilidad real del consultorio</span>
                <span><Icon name="check" size={16} strokeWidth={2.4} /> Reserva disponible desde el celular</span>
                <span><Icon name="check" size={16} strokeWidth={2.4} /> El turno queda incorporado a la agenda</span>
              </div>
            </div>

            <div class="microdemo-wrap reveal reveal-delay">
              <div class="microdemo-heading"><span class="live-dot"></span> Reserva del paciente</div>
              <video
                class="booking-demo"
                poster="/media/reserva-turno-poster-v1.webp"
                muted
                playsinline
                loop
                preload="none"
                data-lazy-video
                aria-label="Demostración real de un paciente reservando un turno en Cita Suite"
              >
                <source data-src="/media/reserva-turno-v1.mp4" type="video/mp4" />
              </video>
              <button class="demo-play" type="button" aria-pressed="false" data-video-toggle>
                <span aria-hidden="true">▶</span><span data-video-label>Ver demostración</span>
              </button>
            </div>
          </div>
          <div class="solution-conversion reveal" data-solution-conversion data-problem="reservation">
            <p data-next-context hidden></p>
            <div class="solution-actions">
              <a class="button button-primary button-large button-emphasis" href="#solucion-recordatorios" data-next-solution hidden><span data-next-label></span><Icon name="arrow-right" size={18} /></a>
              <button class="button button-primary button-large button-emphasis" type="button" data-trial-cta data-cta-location="solution-reservation">Quiero probar Cita Suite</button>
            </div>
          </div>
        </div>
      </section>

      <section class="section solution-section reminders-solution" id="solucion-recordatorios" data-problem="reminders" data-track-section="reminders">
        <div class="container">
          <div class="solution-grid solution-grid-reverse">
            <div class="solution-copy reveal">
              <span class="section-kicker">Antes del turno</span>
              <h2>El paciente recibe dos recordatorios antes de atenderse</h2>
              <p>Cita Suite recuerda automáticamente el turno durante el día previo y vuelve a avisar 2 horas antes. Así el paciente no depende solamente de acordarse por su cuenta.</p>
              <div class="reminder-timing" aria-label="Momentos de los recordatorios">
                <div><span>24 h</span><strong>Durante el día previo</strong></div>
                <i></i>
                <div><span>2 h</span><strong>Antes del turno</strong></div>
              </div>
              <p class="secondary-feature">Si el turno cambia, recepción también puede gestionar la reprogramación desde la agenda.</p>
            </div>

            <div class="reminder-proof reveal reveal-delay">
              <div class="proof-label"><Icon name="message" size={16} /> Pantalla real del paciente</div>
              <img
                src={reminderActivated.src}
                width={reminderActivated.width}
                height={reminderActivated.height}
                loading="lazy"
                decoding="async"
                alt="Pantalla real de Cita Suite confirmando que avisará durante el día previo y 2 horas antes del turno"
              />
            </div>
          </div>
          <div class="solution-conversion reveal" data-solution-conversion data-problem="reminders">
            <p data-next-context hidden></p>
            <div class="solution-actions">
              <a class="button button-primary button-large button-emphasis" href="#solucion-informacion" data-next-solution hidden><span data-next-label></span><Icon name="arrow-right" size={18} /></a>
              <button class="button button-primary button-large button-emphasis" type="button" data-trial-cta data-cta-location="solution-reminders">Quiero probar Cita Suite</button>
            </div>
          </div>
        </div>
      </section>

      <section class="section solution-section information-solution" id="solucion-informacion" data-problem="information" data-track-section="information">
        <div class="container">
          <div class="solution-grid">
            <div class="solution-copy reveal">
              <span class="section-kicker">Información disponible cuando la necesitás</span>
              <h2>{copy.informationTitle}</h2>
              <p>{copy.informationLead}</p>
              <p class="concrete-line"><Icon name="check" size={16} /> {copy.informationDetail}</p>
            </div>

            <div class="information-proof reveal reveal-delay">
              <div class="screenshot-wrap screenshot-radiographs">
                <ProductScreenshot
                  src={radiographsScreenshot}
                  alt={copy.informationAlt}
                  sizes="(max-width: 760px) calc(100vw - 52px), (max-width: 1200px) 52vw, 650px"
                />
                <div class="visual-badge"><span><Icon name="file" size={15} /></span> Archivo asociado al paciente</div>
              </div>
            </div>
          </div>
          <div class="solution-conversion reveal" data-solution-conversion data-problem="information">
            <p data-next-context hidden></p>
            <div class="solution-actions">
              <a class="button button-primary button-large button-emphasis" href="#solucion-informacion" data-next-solution hidden><span data-next-label></span><Icon name="arrow-right" size={18} /></a>
              <button class="button button-primary button-large button-emphasis" type="button" data-trial-cta data-cta-location="solution-information">Quiero probar Cita Suite</button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="section team-section" data-track-section="team">
      <div class="container">
        <div class="team-intro reveal">
          <div>
            <span class="section-kicker">Trabajo en equipo</span>
            <h2>Una sola fuente de información para todo el consultorio</h2>
          </div>
          <p>Recepción necesita administrar. El profesional necesita encontrar rápido la información del paciente. Ambos pueden trabajar sobre el mismo sistema sin tener necesariamente los mismos accesos.</p>
        </div>

        <div class="role-layout">
          <div class="role-list reveal">
            <article><span class="role-icon"><Icon name="calendar" size={20} /></span><div><h3>Recepción</h3><p>Agenda, pacientes y coordinación diaria.</p></div></article>
            <article><span class="role-icon"><Icon name="users" size={20} /></span><div><h3>Profesional</h3><p>Sus turnos y la información que necesita para atender.</p></div></article>
            <article><span class="role-icon"><Icon name="shield" size={20} /></span><div><h3>Administración</h3><p>Configuración del consultorio, equipo y funcionamiento general.</p></div></article>
          </div>
          <div class="team-screenshot reveal reveal-delay">
            <ProductScreenshot src={teamScreenshot} alt="Captura real de la organización de equipo y roles en Cita Suite" sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1200px) 60vw, 750px" />
          </div>
        </div>
      </div>
    </section>

    <section class="onboarding-section" id="ayuda" data-track-section="onboarding">
      <div class="container onboarding-card reveal">
        <div class="onboarding-copy">
          <span class="dark-kicker">Empezar sin perder tiempo</span>
          <h2>¿No querés configurar todo? Lo hacemos con vos.</h2>
          <p>Nos contás cómo trabaja tu consultorio y te ayudamos a dejar Cita Suite preparado para empezar: profesionales, servicios, horarios, disponibilidad y configuración inicial.</p>
          <p class="choice-line">Podés configurarlo por tu cuenta o hacerlo con nosotros. <strong>Vos elegís.</strong></p>
          <button class="button button-light button-large" type="button" data-trial-cta data-cta-location="onboarding">Quiero probar Cita Suite <Icon name="arrow-right" size={18} /></button>
        </div>

        <div class="setup-flow" aria-label="Proceso de configuración asistida">
          <div class="setup-source"><span class="setup-logo"><Icon name="calendar" size={22} /></span><div><small>PUNTO DE PARTIDA</small><strong>Tu consultorio</strong></div></div>
          <div class="flow-line"><span></span></div>
          <div class="setup-items">
            <span><Icon name="users" size={17} /> Profesionales</span>
            <span><Icon name="file" size={17} /> Servicios</span>
            <span><Icon name="clock" size={17} /> Horarios</span>
            <span><Icon name="calendar" size={17} /> Disponibilidad</span>
          </div>
          <div class="flow-line"><span></span></div>
          <div class="setup-ready"><span><Icon name="check" size={18} strokeWidth={2.5} /></span><div><small>LISTO PARA USAR</small><strong>Cita Suite preparado</strong></div></div>
        </div>
      </div>
    </section>

    <section class="section story-section" data-track-section="story">
      <div class="container story-grid">
        <div class="story-number reveal">01</div>
        <div class="story-copy reveal">
          <span class="section-kicker">El origen del producto</span>
          <h2>Cita Suite nació de problemas reales de consultorio</h2>
          <p>{copy.storyOrigin}</p>
          <p>Cita Suite se construyó alrededor de esas situaciones concretas, no de una lista genérica de funcionalidades.</p>
        </div>
        <blockquote class="story-quote reveal reveal-delay">
          <Icon name="message" size={24} />
          <p>“{copy.storyQuote}”</p>
          <footer>El problema que inició Cita Suite</footer>
        </blockquote>
      </div>
    </section>

    <section class="section security-section" id="seguridad" data-track-section="security">
      <div class="container">
        <div class="security-header reveal">
          <span class="security-mark"><Icon name="shield" size={28} /></span>
          <div><span class="section-kicker">Confianza y control</span><h2>La información del consultorio, con accesos organizados</h2></div>
        </div>
        <div class="security-grid">
          <article class="reveal"><span>01</span><h3>Accesos según rol</h3><p>Cada integrante del equipo accede según las funciones que necesita realizar.</p></article>
          <article class="reveal"><span>02</span><h3>Información centralizada</h3><p>Pacientes, turnos y archivos dejan de depender de cuentas o dispositivos personales dispersos.</p></article>
          <article class="reveal"><span>03</span><h3>Control del consultorio</h3><p>La administración mantiene organizado quién forma parte del equipo y cómo trabaja dentro de Cita Suite.</p></article>
        </div>
        <a class="text-link" href="https://cita-suite.netlify.app/privacidad">Privacidad y seguridad <Icon name="arrow-right" size={16} /></a>
      </div>
    </section>

    <section class="section pricing-section" id="precio" data-track-section="pricing">
      <div class="container pricing-layout">
        <div class="pricing-intro reveal">
          <span class="section-kicker">Precio transparente</span>
          <h2>Un precio simple</h2>
          <p>Sin planes artificiales ni funciones escondidas detrás de cinco niveles distintos.</p>
          <div class="price-note"><Icon name="sparkles" size={20} /><span><strong>También te ayudamos a empezar.</strong> La configuración asistida está incluida.</span></div>
        </div>

        <article class="pricing-card reveal reveal-delay">
          <div class="pricing-card-top">
            <div><span class="plan-name">Cita Suite</span><span class="plan-badge">Plan único</span></div>
            <p>Para organizar el trabajo de tu consultorio desde una misma plataforma.</p>
          </div>
          <div class="price"><span>ARS</span><strong>50.000</strong><small>/ mes</small></div>
          <div class="included-list">
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Agenda y turnos</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Reserva autónoma de pacientes</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Gestión de pacientes</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> {copy.priceFiles}</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Recordatorios automáticos</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Accesos para el equipo</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Soporte y configuración asistida</span>
          </div>
          <button class="button button-primary button-large button-block" type="button" data-trial-cta data-cta-location="pricing">Quiero probar Cita Suite <Icon name="arrow-right" size={18} /></button>
          <a class="price-demo-link" href="#solucion-reserva" data-track-cta="price-see-how">¿Querés verlo primero? <strong>Ver cómo funciona</strong></a>
        </article>
      </div>
    </section>

    <section class="section faq-section" id="preguntas" data-track-section="faq">
      <div class="container faq-layout">
        <div class="faq-heading reveal">
          <span class="section-kicker">Antes de empezar</span>
          <h2>Preguntas frecuentes</h2>
          <p>Lo más importante para saber si Cita Suite encaja con tu forma de trabajar.</p>
        </div>
        <div class="faq-list reveal reveal-delay">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary><span>{faq.question}</span><span class="faq-icon"><Icon name="chevron-down" size={19} /></span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta-section" id="contacto" data-track-section="final-cta">
      <div class="container final-cta-card reveal">
        <div class="final-cta-glow"></div>
        <span class="dark-kicker">Tu consultorio, en un solo lugar</span>
        <h2>Menos turnos perdidos.<br />Menos información dispersa.</h2>
        <p>{copy.finalLead}</p>
        <div class="final-actions">
          <button class="button button-light button-large" type="button" data-trial-cta data-cta-location="final">Quiero probar Cita Suite <Icon name="arrow-right" size={18} /></button>
          <a class="button button-dark-outline button-large" href="#solucion-reserva" data-track-cta="final-see-how">Ver cómo funciona</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand"><Brand /><p>Gestión para consultorios.</p></div>
      <div><h3>Producto</h3><a href="#soluciones">Funciones</a><a href="#como-funciona">Cómo funciona</a><a href="#precio">Precio</a></div>
      <div><h3>Contacto</h3><button type="button" data-trial-cta data-cta-location="footer">Quiero probar Cita Suite</button><a href="#preguntas">Preguntas frecuentes</a><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a></div>
      <div><h3>Legal</h3><a href="https://cita-suite.netlify.app/privacidad">Privacidad</a><a href="https://cita-suite.netlify.app/terminos">Términos y condiciones</a><a href="#seguridad">Seguridad</a></div>
    </div>
    <div class="container footer-bottom"><span>© 2026 Cita Suite</span></div>
  </footer>

  <dialog class="trial-dialog" data-trial-dialog aria-labelledby="trial-title">
    <div class="trial-dialog-card">
      <button class="dialog-close" type="button" data-dialog-close aria-label="Cerrar"><Icon name="x" size={21} /></button>
      <span class="dialog-kicker">Un paso antes de WhatsApp</span>
      <h2 id="trial-title">Quiero probar Cita Suite</h2>
      <p>Contanos cómo llamarte o dejá un teléfono para asociar la conversación con tu consulta.</p>

      <form data-lead-form novalidate>
        <label for="lead-name">Nombre <span>opcional</span></label>
        <input id="lead-name" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Cómo te llamás" />

        <label for="lead-phone">Número de teléfono <span>opcional</span></label>
        <input id="lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="32" placeholder="Ej. 342 555 1234" />

        <input class="honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="form-helper">Con uno de los dos alcanza.</p>
        <p class="form-error" data-form-error hidden role="alert"></p>
        <button class="button button-primary button-large button-block" type="submit" disabled data-whatsapp-submit>
          Continuar por WhatsApp <Icon name="arrow-right" size={18} />
        </button>
      </form>
    </div>
  </dialog>

  <script>
    import '../scripts/landing';
  </script>
</BaseLayout>
