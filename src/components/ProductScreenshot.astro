---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
  sizes?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  sizes = '(max-width: 760px) calc(100vw - 32px), (max-width: 1200px) calc(100vw - 48px), 760px'
} = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={[480, 800, 1200]}
  sizes={sizes}
  loading={loading}
  decoding="async"
  pictureAttributes={{ class: 'product-picture' }}
/>
