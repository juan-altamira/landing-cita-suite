---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgendaMockup from '../components/AgendaMockup.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';

const appUrl = 'https://cita-suite.netlify.app/login';
const supportUrl = 'https://cita-suite.netlify.app/login';

const problems = [
  {
    icon: 'clock' as const,
    number: '01',
    title: 'Un paciente se olvida del turno',
    text: 'El horario queda reservado, pero el paciente simplemente no aparece.'
  },
  {
    icon: 'file' as const,
    number: '02',
    title: 'La radiografía está, pero no donde la necesitás',
    text: 'Quedó en otra computadora, otro dispositivo o en manos de otro profesional.'
  },
  {
    icon: 'folder' as const,
    number: '03',
    title: 'La información está repartida',
    text: 'Parte en la agenda, parte en mensajes y parte en archivos que hay que buscar.'
  },
  {
    icon: 'message' as const,
    number: '04',
    title: 'Cambiar un turno genera trabajo de más',
    text: 'Mensajes, confirmaciones, horarios disponibles y nuevas coordinaciones.'
  }
];

const tourTabs = [
  {
    id: 'agenda',
    label: 'Agenda',
    title: 'Todos trabajan sobre la misma agenda',
    text: 'Visualizá los turnos del consultorio, organizalos por profesional y mantené actualizada la disponibilidad desde un único lugar.',
    note: 'También podés coordinar turnos que requieren más de un profesional.',
    image: null
  },
  {
    id: 'pacientes',
    label: 'Pacientes',
    title: 'La información empieza por el paciente',
    text: 'Accedé a sus datos, turnos y archivos asociados sin tener que reconstruir la información cada vez que vuelve al consultorio.',
    note: null,
    image: '/images/producto-paciente.webp'
  },
  {
    id: 'radiografias',
    label: 'Radiografías y archivos',
    title: 'La radiografía queda asociada a quien corresponde',
    text: 'Guardá radiografías y otros archivos junto a la ficha del paciente para encontrarlos cuando realmente los necesitás.',
    note: null,
    image: '/images/producto-radiografias.webp'
  },
  {
    id: 'recordatorios',
    label: 'Turnos y recordatorios',
    title: 'El turno no termina cuando lo cargás en la agenda',
    text: 'Cita Suite acompaña el turno con recordatorios y herramientas para confirmar, cancelar o reprogramar sin desordenar el resto de la agenda.',
    note: null,
    image: '/images/producto-recordatorios.webp'
  },
  {
    id: 'equipo',
    label: 'Equipo',
    title: 'Recepción y profesionales, dentro del mismo sistema',
    text: 'Cada integrante accede con el rol que le corresponde y trabaja sobre información actualizada del consultorio.',
    note: null,
    image: '/images/producto-equipo.webp'
  }
];

const faqs = [
  {
    question: '¿Tengo que instalar algo?',
    answer: 'No. Cita Suite funciona desde el navegador, por lo que podés acceder desde las computadoras del consultorio sin instalar un programa tradicional.'
  },
  {
    question: '¿Pueden usarlo varios profesionales?',
    answer: 'Sí. El consultorio puede trabajar con distintos usuarios y roles para que recepción, profesionales y administración accedan a las funciones que les corresponden.'
  },
  {
    question: '¿Puedo asociar radiografías a un paciente?',
    answer: 'Sí. Podés guardar radiografías y otros archivos junto a la ficha del paciente para mantener su información organizada y disponible para los profesionales autorizados.'
  },
  {
    question: '¿Cómo funcionan los recordatorios?',
    answer: 'Cita Suite permite acompañar los turnos con recordatorios y opciones de confirmación, cancelación y reprogramación para reducir la dependencia de mensajes manuales.'
  },
  {
    question: '¿Tengo que configurar todo yo?',
    answer: 'No. Si preferís, podés solicitar ayuda y te acompañamos con la configuración inicial del consultorio, sus profesionales, servicios, horarios y disponibilidad.'
  },
  {
    question: '¿Qué pasa si necesito ayuda?',
    answer: 'Podés solicitar asistencia directamente cuando la necesites. Durante la puesta en marcha también podemos ayudarte a dejar el consultorio preparado para empezar a trabajar.'
  },
  {
    question: '¿Se puede usar desde el celular?',
    answer: 'Cita Suite está pensado principalmente para el trabajo cotidiano desde computadora. Los pacientes, en cambio, pueden acceder desde su celular a los enlaces relacionados con sus turnos.'
  },
  {
    question: '¿Quién puede ver la información de los pacientes?',
    answer: 'Los accesos se organizan según los roles y permisos definidos dentro del consultorio.'
  }
];
---

<BaseLayout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header" data-header>
    <div class="container header-inner">
      <Brand compact />

      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#funciones">Funciones</a>
        <a href="#precio">Precio</a>
        <a href="#preguntas">Preguntas frecuentes</a>
      </nav>

      <div class="header-actions">
        <a class="login-link" href={appUrl}>Ingresar</a>
        <a class="button button-small button-primary" href={appUrl}>Probar Cita Suite</a>
      </div>

      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-icon"><Icon name="menu" size={23} /></span>
        <span class="close-icon"><Icon name="x" size={23} /></span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-menu" data-mobile-menu>
      <nav aria-label="Navegación móvil">
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#funciones">Funciones</a>
        <a href="#precio">Precio</a>
        <a href="#preguntas">Preguntas frecuentes</a>
        <a href={appUrl}>Ingresar</a>
        <a class="button button-primary" href={appUrl}>Probar Cita Suite</a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <section class="hero" id="inicio">
      <div class="hero-decoration hero-decoration-one"></div>
      <div class="hero-decoration hero-decoration-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <div class="eyebrow"><span></span> Software de gestión para consultorios</div>
          <h1>Menos turnos perdidos. <span>Toda la información</span> del consultorio, en un solo lugar.</h1>
          <p class="hero-lead">Organizá agenda, pacientes, radiografías y comunicación de turnos desde una misma plataforma, para que recepción y profesionales trabajen con la misma información.</p>
          <div class="hero-actions">
            <a class="button button-primary button-large" href="#como-funciona">Ver cómo funciona <Icon name="arrow-right" size={18} /></a>
            <a class="button button-secondary button-large" href={appUrl}>Probar Cita Suite</a>
          </div>
          <p class="assistance-note"><Icon name="sparkles" size={17} /> <span><strong>Configuración asistida disponible.</strong> Si querés, te ayudamos a dejar todo listo.</span></p>
        </div>

        <div class="hero-product reveal reveal-delay">
          <div class="product-label"><span class="live-dot"></span> Vista de agenda</div>
          <AgendaMockup />
        </div>
      </div>
    </section>

    <section class="trust-bar" aria-label="Beneficios de implementación">
      <div class="container trust-grid">
        <div><span><Icon name="check" size={15} strokeWidth={2.5} /></span> Sin instalación</div>
        <div><span><Icon name="check" size={15} strokeWidth={2.5} /></span> Configuración asistida</div>
        <div><span><Icon name="check" size={15} strokeWidth={2.5} /></span> Accesos según rol</div>
        <div><span><Icon name="check" size={15} strokeWidth={2.5} /></span> Soporte directo</div>
      </div>
    </section>

    <section class="section problems-section" id="funciones">
      <div class="container">
        <div class="section-heading centered narrow reveal">
          <span class="section-kicker">El día a día del consultorio</span>
          <h2>¿Te pasa alguna de estas cosas?</h2>
          <p>Pequeñas fricciones terminan consumiendo tiempo, complicando al equipo o dejando turnos vacíos.</p>
        </div>

        <div class="problem-grid">
          {problems.map((problem) => (
            <article class="problem-card reveal">
              <div class="problem-topline">
                <span class="problem-icon"><Icon name={problem.icon} size={22} /></span>
                <span class="problem-number">{problem.number}</span>
              </div>
              <h3>{problem.title}</h3>
              <p>{problem.text}</p>
            </article>
          ))}
        </div>

        <p class="bridge-statement reveal"><span>Cita Suite</span> reúne todo eso en un mismo flujo de trabajo. <Icon name="arrow-right" size={18} /></p>
      </div>
    </section>

    <section class="section tour-section" id="como-funciona">
      <div class="container">
        <div class="section-heading split-heading reveal">
          <div>
            <span class="section-kicker">Así funciona</span>
            <h2>Un sistema pensado para el trabajo real del consultorio</h2>
          </div>
          <p>Agenda, pacientes, archivos y comunicación trabajando juntos en lugar de funcionar como herramientas separadas.</p>
        </div>

        <div class="tour-desktop reveal" data-tour>
          <div class="tour-nav" role="tablist" aria-label="Recorrido por el producto">
            {tourTabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-tour-tab={tab.id}
              >
                <span class="tab-index">0{index + 1}</span>
                <span>{tab.label}</span>
                <Icon name="arrow-right" size={16} />
              </button>
            ))}
          </div>

          <div class="tour-panels">
            {tourTabs.map((tab, index) => (
              <article
                class:list={['tour-panel', { active: index === 0 }]}
                role="tabpanel"
                id={`panel-${tab.id}`}
                aria-labelledby={`tab-${tab.id}`}
                hidden={index !== 0}
                data-tour-panel={tab.id}
              >
                <div class="tour-copy">
                  <span class="product-tag">{tab.label}</span>
                  <h3>{tab.title}</h3>
                  <p>{tab.text}</p>
                  {tab.note && <p class="tour-note"><Icon name="users" size={16} /> {tab.note}</p>}
                </div>
                <div class:list={['product-frame', { 'agenda-frame': !tab.image }]}>
                  {tab.image ? (
                    <img src={tab.image} alt={`Captura real de Cita Suite: ${tab.label}`} width="1440" height="1000" loading={index === 0 ? 'eager' : 'lazy'} />
                  ) : (
                    <AgendaMockup compact />
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="tour-mobile">
          {tourTabs.map((tab, index) => (
            <details open={index === 0}>
              <summary>
                <span><b>0{index + 1}</b> {tab.label}</span>
                <span class="summary-icon"><Icon name="chevron-down" size={18} /></span>
              </summary>
              <div class="mobile-tour-content">
                <h3>{tab.title}</h3>
                <p>{tab.text}</p>
                {tab.note && <p class="tour-note"><Icon name="users" size={16} /> {tab.note}</p>}
                <div class:list={['product-frame', { 'agenda-frame': !tab.image }]}>
                  {tab.image ? (
                    <img src={tab.image} alt={`Captura real de Cita Suite: ${tab.label}`} width="1440" height="1000" loading="lazy" />
                  ) : (
                    <AgendaMockup compact />
                  )}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section feature-section feature-soft" id="radiografias">
      <div class="container feature-grid">
        <div class="feature-visual reveal">
          <div class="screenshot-wrap screenshot-radiographs">
            <img src="/images/producto-radiografias.webp" alt="Captura real de radiografías asociadas a la ficha de un paciente en Cita Suite" width="1440" height="1000" loading="lazy" />
            <div class="visual-badge"><span><Icon name="file" size={15} /></span> Archivo asociado al paciente</div>
          </div>
        </div>
        <div class="feature-copy reveal reveal-delay">
          <span class="section-kicker">Información disponible cuando la necesitás</span>
          <h2>La radiografía no debería depender de quién la tenga</h2>
          <p>Asociá radiografías y archivos a la ficha del paciente para que los profesionales autorizados puedan encontrarlos desde Cita Suite cuando los necesitan.</p>
          <p class="concrete-line"><Icon name="check" size={16} /> Sin pedir que alguien te reenvíe el archivo.</p>
          <p class="concrete-line"><Icon name="check" size={16} /> Sin buscar en distintos dispositivos.</p>
        </div>
      </div>
    </section>

    <section class="section feature-section reminders-section">
      <div class="container feature-grid feature-grid-reverse">
        <div class="feature-copy reveal">
          <span class="section-kicker">Antes del turno</span>
          <h2>Un turno no debería depender de que el paciente se acuerde solo</h2>
          <p>Los recordatorios y las opciones de confirmación ayudan a mantener al paciente informado y a detectar cambios antes de que llegue la hora del turno.</p>

          <div class="appointment-flow" aria-label="Flujo de comunicación de un turno">
            <div><span>01</span><strong>Turno creado</strong></div>
            <i></i>
            <div><span>02</span><strong>Recordatorio</strong></div>
            <i></i>
            <div><span>03</span><strong>Respuesta</strong></div>
            <i></i>
            <div><span>04</span><strong>Agenda actualizada</strong></div>
          </div>
        </div>
        <div class="feature-visual reveal reveal-delay">
          <div class="screenshot-wrap screenshot-reminders">
            <img src="/images/producto-recordatorios.webp" alt="Captura real de los turnos para recordar en Cita Suite" width="1440" height="1000" loading="lazy" />
            <div class="visual-badge visual-badge-teal"><span><Icon name="message" size={15} /></span> Recordatorio preparado</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section team-section">
      <div class="container">
        <div class="team-intro reveal">
          <div>
            <span class="section-kicker">Trabajo en equipo</span>
            <h2>Una sola fuente de información para todo el consultorio</h2>
          </div>
          <p>Recepción necesita administrar. El profesional necesita encontrar rápido la información del paciente. Ambos pueden trabajar sobre el mismo sistema sin tener necesariamente los mismos accesos.</p>
        </div>

        <div class="role-layout">
          <div class="role-list reveal">
            <article>
              <span class="role-icon"><Icon name="calendar" size={20} /></span>
              <div><h3>Recepción</h3><p>Agenda, pacientes y coordinación diaria.</p></div>
            </article>
            <article>
              <span class="role-icon"><Icon name="tooth" size={20} /></span>
              <div><h3>Profesional</h3><p>Sus turnos y la información que necesita para atender.</p></div>
            </article>
            <article>
              <span class="role-icon"><Icon name="shield" size={20} /></span>
              <div><h3>Administración</h3><p>Configuración del consultorio, equipo y funcionamiento general.</p></div>
            </article>
          </div>
          <div class="team-screenshot reveal reveal-delay">
            <img src="/images/producto-equipo.webp" alt="Captura real de la organización de equipo y roles en Cita Suite" width="1440" height="1000" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section class="onboarding-section" id="ayuda">
      <div class="container onboarding-card reveal">
        <div class="onboarding-copy">
          <span class="dark-kicker">Empezar sin perder tiempo</span>
          <h2>¿No querés configurar todo? Lo hacemos con vos.</h2>
          <p>Nos pasás cómo trabaja tu consultorio y te ayudamos a dejar Cita Suite preparado para empezar: profesionales, servicios, horarios, disponibilidad y configuración inicial.</p>
          <p class="choice-line">Podés configurarlo por tu cuenta o pedir ayuda. <strong>Vos elegís.</strong></p>
          <a class="button button-light button-large" href={supportUrl}>Solicitar ayuda <Icon name="arrow-right" size={18} /></a>
        </div>

        <div class="setup-flow" aria-label="Proceso de configuración asistida">
          <div class="setup-source"><span class="setup-logo"><Icon name="tooth" size={22} /></span><div><small>PUNTO DE PARTIDA</small><strong>Tu consultorio</strong></div></div>
          <div class="flow-line"><span></span></div>
          <div class="setup-items">
            <span><Icon name="users" size={17} /> Profesionales</span>
            <span><Icon name="file" size={17} /> Servicios</span>
            <span><Icon name="clock" size={17} /> Horarios</span>
            <span><Icon name="calendar" size={17} /> Disponibilidad</span>
          </div>
          <div class="flow-line"><span></span></div>
          <div class="setup-ready"><span><Icon name="check" size={18} strokeWidth={2.5} /></span><div><small>LISTO PARA USAR</small><strong>Cita Suite preparado</strong></div></div>
        </div>
      </div>
    </section>

    <section class="section story-section">
      <div class="container story-grid">
        <div class="story-number reveal">01</div>
        <div class="story-copy reveal">
          <span class="section-kicker">El origen del producto</span>
          <h2>Cita Suite nació de problemas reales de consultorio</h2>
          <p>El primer pedido que dio origen al producto fue simple: poder asociar radiografías a pacientes. A partir de ahí aparecieron otros problemas cotidianos, como información repartida, coordinación entre profesionales y pacientes que olvidan sus turnos.</p>
          <p>Cita Suite se construyó alrededor de esas situaciones concretas, no de una lista genérica de funcionalidades.</p>
        </div>
        <blockquote class="story-quote reveal reveal-delay">
          <Icon name="message" size={24} />
          <p>“Necesito encontrar la radiografía cuando estoy con el paciente, sin depender del dispositivo de otra persona.”</p>
          <footer>El problema que inició Cita Suite</footer>
        </blockquote>
      </div>
    </section>

    <section class="section security-section" id="seguridad">
      <div class="container">
        <div class="security-header reveal">
          <span class="security-mark"><Icon name="shield" size={28} /></span>
          <div><span class="section-kicker">Confianza y control</span><h2>La información del consultorio, con accesos organizados</h2></div>
        </div>
        <div class="security-grid">
          <article class="reveal"><span>01</span><h3>Accesos según rol</h3><p>Cada integrante del equipo accede según las funciones que necesita realizar.</p></article>
          <article class="reveal"><span>02</span><h3>Información centralizada</h3><p>Pacientes, turnos y archivos dejan de depender de cuentas o dispositivos personales dispersos.</p></article>
          <article class="reveal"><span>03</span><h3>Control del consultorio</h3><p>La administración mantiene organizado quién forma parte del equipo y cómo trabaja dentro de Cita Suite.</p></article>
        </div>
        <a class="text-link" href="https://cita-suite.netlify.app/privacidad">Privacidad y seguridad <Icon name="arrow-right" size={16} /></a>
      </div>
    </section>

    <section class="section pricing-section" id="precio">
      <div class="container pricing-layout">
        <div class="pricing-intro reveal">
          <span class="section-kicker">Precio transparente</span>
          <h2>Un precio simple</h2>
          <p>Sin planes artificiales ni funciones escondidas detrás de cinco niveles distintos.</p>
          <div class="price-note"><Icon name="sparkles" size={20} /><span><strong>También te ayudamos a empezar.</strong> La configuración asistida está incluida.</span></div>
        </div>

        <article class="pricing-card reveal reveal-delay">
          <div class="pricing-card-top">
            <div><span class="plan-name">Cita Suite</span><span class="plan-badge">Plan único</span></div>
            <p>Para organizar el trabajo de tu consultorio desde una misma plataforma.</p>
          </div>
          <div class="price"><span>ARS</span><strong>50.000</strong><small>/ mes</small></div>
          <p class="price-context">Precio mensual por consultorio.</p>
          <div class="included-list">
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Agenda y turnos</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Gestión de pacientes</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Radiografías y archivos</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Recordatorios y confirmaciones</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Accesos para el equipo</span>
            <span><i><Icon name="check" size={14} strokeWidth={2.5} /></i> Soporte y configuración asistida</span>
          </div>
          <a class="button button-primary button-large button-block" href={appUrl}>Probar Cita Suite <Icon name="arrow-right" size={18} /></a>
          <a class="price-demo-link" href="#como-funciona">¿Querés verlo primero? <strong>Ver cómo funciona</strong></a>
        </article>
      </div>
    </section>

    <section class="section faq-section" id="preguntas">
      <div class="container faq-layout">
        <div class="faq-heading reveal">
          <span class="section-kicker">Antes de empezar</span>
          <h2>Preguntas frecuentes</h2>
          <p>Lo más importante para saber si Cita Suite encaja con tu forma de trabajar.</p>
          <a class="text-link" href={supportUrl}>¿Te quedó una duda? Escribinos <Icon name="arrow-right" size={16} /></a>
        </div>
        <div class="faq-list reveal reveal-delay">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary><span>{faq.question}</span><span class="faq-icon"><Icon name="chevron-down" size={19} /></span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta-section" id="contacto">
      <div class="container final-cta-card reveal">
        <div class="final-cta-glow"></div>
        <span class="dark-kicker">Tu consultorio, en un solo lugar</span>
        <h2>Menos turnos perdidos.<br />Menos información dispersa.</h2>
        <p>Probá Cita Suite y centralizá agenda, pacientes, radiografías y coordinación del consultorio en una misma plataforma.</p>
        <div class="final-actions">
          <a class="button button-light button-large" href={appUrl}>Probar Cita Suite <Icon name="arrow-right" size={18} /></a>
          <a class="button button-dark-outline button-large" href={supportUrl}>Solicitar ayuda</a>
        </div>
        <a class="final-demo-link" href="#como-funciona">Si preferís conocerlo primero, podés ver cómo funciona.</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <Brand />
        <p>Gestión para consultorios.</p>
      </div>
      <div><h3>Producto</h3><a href="#funciones">Funciones</a><a href="#como-funciona">Cómo funciona</a><a href="#precio">Precio</a></div>
      <div><h3>Ayuda</h3><a href={supportUrl}>Solicitar ayuda</a><a href="#preguntas">Preguntas frecuentes</a><a href={supportUrl}>Contacto</a></div>
      <div><h3>Legal</h3><a href="https://cita-suite.netlify.app/privacidad">Privacidad</a><a href="https://cita-suite.netlify.app/terminos">Términos y condiciones</a><a href="#seguridad">Seguridad</a></div>
    </div>
    <div class="container footer-bottom"><span>© 2026 Cita Suite</span><span>Hecho para el trabajo real del consultorio.</span></div>
  </footer>

  <script>
    const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

    const closeMenu = () => {
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Abrir menú');
      mobileMenu?.classList.remove('open');
      document.body.classList.remove('menu-open');
    };

    menuButton?.addEventListener('click', () => {
      const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
      menuButton.setAttribute('aria-expanded', String(willOpen));
      menuButton.setAttribute('aria-label', willOpen ? 'Cerrar menú' : 'Abrir menú');
      mobileMenu?.classList.toggle('open', willOpen);
      document.body.classList.toggle('menu-open', willOpen);
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    window.addEventListener('resize', () => { if (window.innerWidth > 900) closeMenu(); });

    document.querySelectorAll<HTMLElement>('[data-tour]').forEach((tour) => {
      const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-tour-tab]')];
      const panels = [...tour.querySelectorAll<HTMLElement>('[data-tour-panel]')];

      const activateTab = (tab: HTMLButtonElement) => {
        const id = tab.dataset.tourTab;
        tabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          const active = panel.dataset.tourPanel === id;
          panel.hidden = !active;
          panel.classList.toggle('active', active);
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateTab(tab));
        tab.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
          event.preventDefault();
          const direction = event.key === 'ArrowDown' ? 1 : -1;
          const next = tabs[(index + direction + tabs.length) % tabs.length];
          activateTab(next);
          next.focus();
        });
      });
    });

    document.querySelectorAll('.tour-mobile details').forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!(item as HTMLDetailsElement).open) return;
        document.querySelectorAll('.tour-mobile details').forEach((other) => {
          if (other !== item) (other as HTMLDetailsElement).open = false;
        });
      });
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReducedMotion && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('reveal-ready');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -60px', threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
    }
  </script>
</BaseLayout>
