{
  // Landing pública en cita-suite.com.ar: sólo archivos estáticos de `astro build`, sin
  // código propio. Las solicitudes a archivos estáticos no consumen la cuota de Workers.
  "name": "cita-suite-landing",
  "account_id": "52b358653379c162b5a07b10ae5e84b3",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Mismas rutas que en Vercel: /odontologia responde sin barra final.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "cita-suite.com.ar", "custom_domain": true }]
}
